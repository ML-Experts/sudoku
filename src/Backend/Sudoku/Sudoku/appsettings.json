{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "Runtime": {
    "Environment": "local",
    "ServiceName": "sudoku-backend",
    "ServiceVersion": "0.1.0"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MlService": {
    "BaseUrl": "http://127.0.0.1:8000",
    "PingPath": "/ml/ping",
    "PreprocessBoardPath": "/ml/preprocess/board",
    "PreprocessCellsPath": "/ml/preprocess/cells",
    "CellInferencePath": "/ml/cells/inference",
    "PrepareDatasetPath": "/ml/datasets/prepare",
    "StartTrainingPath": "/ml/trainings",
    "CancelTrainingPathTemplate": "/ml/trainings/{runName}/cancel",
    "TrainingEventsPathTemplate": "/internal/ml/trainings/{runName}/events",
    "TimeoutSeconds": 120
  },
  "ExamplesStorage": {
    "RootPath": "../../../../examples",
    "UploadsSubdirectory": "uploads"
  },
  "ExamplesUpload": {
    "MaxUploadSizeBytes": 10485760
  },
  "ExamplesPreprocess": {
    "MaxInlineImageSizeBytes": 10485760
  },
  "SudokuCellsInference": {
    "MaxInlineImageSizeBytes": 10485760,
    "InferenceProfileName": "default-28x28-v1"
  },
  "AdminAuth": {
    "TokenLifetimeMinutes": 60
  },
  "DatasetsPreparation": {
    "DefaultPreprocessingProfile": "default-28x28-v1",
    "DefaultMixSplitRatios": {
      "Train": 0.8,
      "Val": 0.1,
      "Test": 0.1
    }
  },
  "TrainingDefaults": {
    "RunNamePrefix": "train",
    "TrainingMode": "fineTuning",
    "TrainingProfileName": "cnn-default-v1",
    "AugmentationProfileName": "digits-light-v1",
    "BenchmarkName": "sudoku-benchmark-v1",
    "Seed": 1234
  },
  "TrainingRecovery": {
    "StaleCancellingTimeoutSeconds": 300
  },
  "AllowedHosts": "*"
}
