{
  "Runtime": {
    "Environment": "local",
    "ServiceName": "sudoku-backend",
    "ServiceVersion": "0.1.0"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MlService": {
    "BaseUrl": "http://127.0.0.1:8000",
    "PingPath": "/ml/ping",
    "PreprocessBoardPath": "/ml/preprocess/board",
    "PreprocessCellsPath": "/ml/preprocess/cells",
    "PrepareDatasetPath": "/ml/datasets/prepare",
    "TimeoutSeconds": 120
  },
  "ExamplesStorage": {
    "RootPath": "../../../../examples",
    "UploadsSubdirectory": "uploads"
  },
  "ExamplesUpload": {
    "MaxUploadSizeBytes": 10485760
  },
  "ExamplesPreprocess": {
    "MaxInlineImageSizeBytes": 10485760
  },
  "AdminAuth": {
    "TokenLifetimeMinutes": 60
  },
  "DatasetsPreparation": {
    "DefaultPreprocessingProfile": "default-28x28-v1",
    "DefaultMixSplitRatios": {
      "Train": 0.8,
      "Val": 0.1,
      "Test": 0.1
    }
  },
  "AllowedHosts": "*"
}
