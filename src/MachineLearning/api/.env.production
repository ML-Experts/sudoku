ML_ENVIRONMENT=production
ML_BOARDS_SUBDIRECTORY=/opt/sudoku/shared/data/raw/boards
ML_DIGITS_SUBDIRECTORY=/opt/sudoku/shared/data/raw/digits
ML_TEMP_DATASETS_DIRECTORY_PATH=/opt/sudoku/shared/tmp/datasets
ML_DATA_RAW_DIR=/opt/sudoku/shared/data/raw
ML_DATA_PROCESSED_DIR=/opt/sudoku/shared/data/processed
ML_DATA_BENCHMARK_DIR=/opt/sudoku/shared/data/benchmark
ML_MODELS_ACTIVE_DIR=/opt/sudoku/shared/models/active
ML_MODELS_REGISTRY_DIR=/opt/sudoku/shared/models/registry
ML_TRAININGS_RUNS_DIR=/opt/sudoku/shared/trainings/runs
ML_TRAININGS_REPORTS_DIR=/opt/sudoku/shared/trainings/reports
ML_TRAININGS_METADATA_DIR=/opt/sudoku/shared/trainings/metadata
ML_EXAMPLES_UPLOADS_DIR=/opt/sudoku/shared/examples/uploads
ML_EXAMPLES_GENERATED_DIR=/opt/sudoku/shared/examples/generated
ML_TMP_DIR=/opt/sudoku/shared/tmp
ML_TRAINING_RUNNER=pytorch
ML_TRAINING_BACKEND_BASE_URL=http://127.0.0.1:5000
ML_TRAINING_EVENT_TIMEOUT_SECONDS=30
ML_TRAINING_TERMINAL_EVENT_RETRY_DELAY_SECONDS=1
ML_TRAINING_TERMINAL_EVENT_MAX_ATTEMPTS=0
ML_TRAINING_DEVICE=auto
ML_TRAINING_MAX_EPOCHS_OVERRIDE=
ML_TRAINING_ALLOWED_OUTPUT_ROOTS=/opt/sudoku/shared
ML_TRAINING_MOCK_INTERVAL_SECONDS=0.75
ML_TRAINING_ACTIVE_EVENT_MAX_ATTEMPTS=1
