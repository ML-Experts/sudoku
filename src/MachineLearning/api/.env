ML_PREPROCESS_CELLS_MINIMUM_CELL_SIZE_PX=8
ML_PREPROCESS_CELLS_OUTPUT_CELL_SIZE=0
ML_PREPROCESS_GRAYSCALE_COLOR_CONVERSION_CODE=6
ML_PREPROCESS_GAUSSIAN_KERNEL_SIZE=5,5
ML_PREPROCESS_GAUSSIAN_SIGMA_X=0.0
ML_PREPROCESS_ADAPTIVE_THRESHOLD_BLOCK_SIZE=11
ML_PREPROCESS_ADAPTIVE_THRESHOLD_C=2
ML_PREPROCESS_BOARD_EDGE_CANNY_THRESHOLD_1=50
ML_PREPROCESS_BOARD_EDGE_CANNY_THRESHOLD_2=150
ML_PREPROCESS_BOARD_EDGE_HOUGH_THRESHOLD=35
ML_PREPROCESS_BOARD_EDGE_MIN_LINE_LENGTH_RATIO=0.08
ML_PREPROCESS_BOARD_EDGE_MAX_LINE_GAP_RATIO=0.005
ML_PREPROCESS_BOARD_EDGE_ANGLE_TOLERANCE_DEGREES=20.0
ML_PREPROCESS_BOARD_EDGE_OUTER_LINE_WINDOW_RATIO=0.1
ML_PREPROCESS_BOARD_EDGE_MINIMUM_BOARD_AREA_RATIO=0.03
ML_PREPROCESS_BOARD_EDGE_MINIMUM_FAMILY_SEGMENTS=4
ML_PREPROCESS_BOARD_EDGE_LINE_POSITION_MERGE_DISTANCE_RATIO=0.012
ML_PREPROCESS_BOARD_EDGE_MINIMUM_DISTINCT_LINES_PER_FAMILY=5
