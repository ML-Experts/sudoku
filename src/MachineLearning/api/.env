ML_TRAINING_BACKEND_BASE_URL=http://127.0.0.1:5000
ML_TRAINING_EVENT_TIMEOUT_SECONDS=30
ML_TRAINING_TERMINAL_EVENT_RETRY_DELAY_SECONDS=1
