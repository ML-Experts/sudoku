ML_PREPROCESS_BOARD_OUTPUT_MIME_TYPE=image/png
ML_PREPROCESS_BOARD_OUTPUT_SIZE=720
ML_PREPROCESS_BOARD_OUTPUT_PADDING_PIXELS=0
