ML_ENVIRONMENT=production
ML_MODELS_REGISTRY_DIRECTORY_PATH=/opt/sudoku/shared/models/registry
ML_ACTIVE_MODEL_DIRECTORY_PATH=/opt/sudoku/shared/models/active
ML_BOOTSTRAP_MODELS_JSON=[{"family":"cnn","type":"custom-cnn-v1","name":"cnn-baseline","displayName":"CNN baseline"},{"family":"resnet","type":"resnet18","displayName":"ResNet18 ImageNet bootstrap"},{"family":"resnet","type":"resnet34","displayName":"ResNet34 ImageNet bootstrap"},{"family":"resnet","type":"resnet50","displayName":"ResNet50 ImageNet bootstrap"},{"family":"resnet","type":"resnet101","displayName":"ResNet101 ImageNet bootstrap"},{"family":"resnet","type":"resnet152","displayName":"ResNet152 ImageNet bootstrap"},{"family":"resnet","type":"wide_resnet50_2","displayName":"Wide ResNet50 2 ImageNet bootstrap"},{"family":"resnet","type":"wide_resnet101_2","displayName":"Wide ResNet101 2 ImageNet bootstrap"}]
ML_BOOTSTRAP_OVERWRITE_EXISTING=false
ML_BOOTSTRAP_SET_ACTIVE_IF_MISSING=true
ML_BOOTSTRAP_DEFAULT_ACTIVE_MODEL=cnn-baseline

